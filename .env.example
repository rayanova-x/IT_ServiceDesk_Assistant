# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real credentials. See PROJECT_HANDOFF.md Section 1 for the
# full reasoning behind each service choice.

# --- Gemini (LLM reasoning: routing, understanding, generation) ---
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_JUDGE_MODEL="gemini-3.5-flash-lite"
GEMINI_STRONG_JUDGE_MODEL="gemini-3.6-flash"

# --- Jira (read-only ticket fetch -- see src/jira_client.py) ---
JIRA_SITE_URL="https://your-site.atlassian.net"
JIRA_EMAIL="your-email@example.com"
JIRA_API_TOKEN="your-jira-api-token"
JIRA_PROJECT_KEY="YOUR_PROJECT_KEY"

# --- Data/runtime paths (src/config.py) ---
# All optional. If unset, each defaults to a path relative to the repo
# root (chroma_db/, local_model_cache/, sessions.db, logs/, data/) --
# exactly today's local-machine behavior. Override these when deploying
# to a different environment (a shared data volume, EFS mount, etc.)
# instead of editing code.
# CHROMA_DB_PATH="/path/to/chroma_db"
# MODEL_CACHE_DIR="/path/to/local_model_cache"
# SESSION_DB_PATH="/path/to/sessions.db"
# LOG_DIR="/path/to/logs"
# DATA_DIR="/path/to/data"
